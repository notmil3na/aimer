# 1. Reglas globales de seguridad y CSP para toda la aplicación
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; frame-ancestors 'none';

# 2. Configuración obligatoria del Service Worker de la PWA
/sw.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8

# 3. Optimización de caché para los archivos estáticos de Vite (JS/CSS con hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable