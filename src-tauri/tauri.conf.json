{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiMalla",
  "version": "1.0.0",
  "identifier": "com.mimalla.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://mallaunimag.com",
    "beforeBuildCommand": "",
    "frontendDist": "https://mallaunimag.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MiMalla",
        "url": "https://mallaunimag.com",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "MiMalla: plan de estudios, horarios, notas y colaboración de tu semestre.",
    "longDescription": "MiMalla es la aplicación de escritorio de mallaunimag.com: plan de estudios, horarios, notas, asignaciones y colaboración de tu semestre, en una ventana nativa ligera.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}